                  }
                ]
              },
              {
                "name": "Autres formes d'épilepsie",
                "items": [
                  {
                    "text": "Épilepsie focale temporale",
                    "cause": "Arguments CONTRE:\n\t□ Pas d'aura\n\t□ Pas d'automatismes\n\t□ Durée trop courte\n\t□ Récupération immédiate",
                    "test": "→ EEG: foyer temporal si présent"
                  },
                  {
                    "text": "Épilepsie myoclonique",
                    "cause": "Arguments CONTRE:\n\t□ Pas de secousses musculaires\n\t□ Immobilité complète\n\t□ Pas de chute",
                    "test": "→ EEG: décharges polypointes-ondes"
                  }
                ]
              },
              {
                "name": "Causes non épileptiques",
                "items": [
                  {
                    "text": "Syncope vasovagale",
                    "cause": "Arguments CONTRE:\n\t□ Position assise/debout non requise\n\t□ Pas de prodromes\n\t□ Durée trop courte\n\t□ Fréquence trop élevée",
                    "test": "→ Test orthostatique, ECG"
                  },
                  {
                    "text": "Troubles du rythme cardiaque",
                    "cause": "Arguments CONTRE:\n\t□ Examen cardiaque normal\n\t□ Contexte non évocateur\n\t□ Absence palpitations",
                    "test": "→ ECG, Holter si doute"
                  },
                  {
                    "text": "Hypoglycémie",
                    "cause": "Arguments CONTRE:\n\t□ Pas de relation aux repas\n\t□ Récupération immédiate\n\t□ Pas de signes neuroglycopéniques",
                    "test": "→ Glycémie capillaire lors d'un épisode"
                  },

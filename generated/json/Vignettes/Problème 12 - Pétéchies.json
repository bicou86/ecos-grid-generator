    "management": {
      "weight": 0.25,
      "criteria": [
        {
          "id": "m1",
          "text": "Diagnostic et diagnostics différentiels",
          "ddSection": {
            "title": "Diagnostics différentiels des pétéchies chez l'enfant",
            "categories": [
              {
                "name": "Hémopathies malignes",
                "items": [
                  {
                    "text": "Leucémie aiguë lymphoblastique (LAL)",
                    "cause": "Arguments POUR:\\n\\t□ Âge typique (2-10 ans)\\n\\t□ Syndrome hémorragique (pétéchies, ecchymoses)\\n\\t□ Syndrome anémique (pâleur, asthénie)\\n\\t□ Fièvre prolongée (4 semaines)\\n\\t□ Douleurs osseuses (genoux)\\n\\t□ Splénomégalie probable",
                    "test": "→ FSC urgente + frottis sanguin"
                  },
                  {
                    "text": "Leucémie aiguë myéloblastique",
                    "cause": "Arguments POSSIBLES:\\n\\t□ Syndrome hémorragique\\n\\t□ Moins fréquente chez l'enfant\\n\\t□ Nécessite différenciation",
                    "test": "→ FSC + cytologie + immunophénotypage"
                  }
                ]
              },
              {
                "name": "Thrombopénies",
                "items": [
                  {
                    "text": "Purpura thrombopénique idiopathique (PTI)",
                    "cause": "Arguments CONTRE:\\n\\t□ Pas de fièvre habituelle\\n\\t□ État général conservé\\n\\t□ Pas de splénomégalie\\n\\t□ Pas de douleurs osseuses",
                    "test": "→ Plaquettes isolées basses, autres lignées normales"
                  },
                  {
                    "text": "Thrombopénie infectieuse",
                    "cause": "Arguments POSSIBLES:\\n\\t□ Fièvre présente\\n\\t□ Contexte viral possible\\n\\t□ Mais durée prolongée",
                    "test": "→ Sérologies virales, FSC"
                  }
                ]
              },
              {
                "name": "Autres causes",
                "items": [
                  {
                    "text": "Vasculite/purpura rhumatoïde",
                    "cause": "Arguments CONTRE:\\n\\t□ Pas de douleurs abdominales\\n\\t□ Pas d'arthrites\\n\\t□ Localisation atypique\\n\\t□ Thrombopénie non habituelle",
                    "test": "→ Plaquettes normales dans purpura rhumatoïde"
                  },
                  {
                    "text": "Dysfonctionnement plaquettaire",
                    "cause": "Arguments CONTRE:\\n\\t□ Pas d'antécédents familiaux\\n\\t□ Apparition aiguë\\n\\t□ Syndrome général associé",
                    "test": "→ Tests d'agrégation plaquettaire"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "m2",
          "text": "Examens complémentaires urgents",
          "details": [
            "Formule sanguine complète [Hb 90 g/L, GB 3.0 G/L, Thrombocytes 15 G/L]",
            "Frottis sanguin [recherche blastes leucémiques]",
            "Répartition leucocytaire [granulocytes 20%, lymphocytes 80%]",
            "Recherche cellules anormales [blastes à confirmer]",
            "Coagulation [TP, TCA si saignements]",
            "Groupe sanguin [en prévision transfusions]"
          ]
        },
        {
          "id": "m3",
          "text": "Examens spécialisés et confirmation diagnostique",
          "details": [
            "Myélogramme [analyse médullaire obligatoire]",
            "Immunophénotypage [caractérisation lignée blastique]",
            "Cytogénétique [pronostic et classification]",
            "Biologie moléculaire [anomalies génétiques]",
            "Bilan d'extension [en cas de confirmation]",
            "Ponction lombaire [recherche envahissement méningé]"
          ]
        },
        {
          "id": "m4",
          "text": "Prise en charge immédiate",
          "details": [
            "Isolement [précautions neutropénie]",
            "Surveillance clinique [saignements, infection]",
            "Support transfusionnel [plaquettes si < 20 G/L]",
            "Prévention infections [hygiène stricte]",
            "Information famille [diagnostic présumé]",
            "Orientation urgente [hématologie pédiatrique]"
          ]
        },
        {
          "id": "m5",
          "text": "Traitement spécialisé de la leucémie",
          "therapySection": {
            "categories": [
              {
                "title": "Chimiothérapie d'induction",
                "items": [
                  {
                    "treatment": "Protocole ALL (selon groupe)",
                    "details": "Vincristine + Daunorubicine + L-Asparaginase + Corticoïdes",
                    "duration": "4-6 semaines jusqu'à rémission complète"
                  },
                  {
                    "treatment": "Support transfusionnel",
                    "details": "Plaquettes, concentrés érythrocytaires selon seuils",
                    "duration": "Pendant phase d'aplasie"
                  }
                ]
              },
              {
                "title": "Traitement de consolidation",
                "items": [
                  {
                    "treatment": "Chimiothérapie intensive",
                    "details": "Méthotrexate haute dose + autres agents",
                    "duration": "4-6 mois après induction"
                  },
                  {
                    "treatment": "Prophylaxie neuro-méningée",
                    "details": "Chimiothérapie intrathécale",
                    "duration": "Selon protocole"
                  }
                ]
              },
              {
                "title": "Traitement d'entretien",
                "items": [
                  {
                    "treatment": "Chimiothérapie orale",
                    "details": "6-Mercaptopurine + Méthotrexate",
                    "duration": "2-3 ans total de traitement"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "m6",
          "text": "Surveillance et pronostic",
          "details": [
            "Suivi hématologique [FSC régulière, myélogrammes]",
            "Détection rechute [clinique et biologique]",
            "Effets secondaires [cardiotoxicité, neuropathie]",
            "Croissance et développement [surveillance long terme]",
            "Soutien psychosocial [enfant et famille]",

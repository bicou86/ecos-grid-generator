                    "text": "Premier épisode asthmatiforme",
                    "cause": "Arguments POUR:\n\t□ Terrain atopique familial\n\t□ Eczéma personnel\n\t□ Sibilances prédominantes",
                    "test": "→ Essai thérapeutique bronchodilatateurs"
                  },
                  {
                    "text": "Corps étranger inhalé",
                    "cause": "Arguments:\n\t□ Toux en mangeant\n\t□ Début brutal\nArguments CONTRE:\n\t□ Prodromes viraux\n\t□ Auscultation bilatérale",
                    "test": "→ Radio thorax, fibroscopie si suspicion"
                  },
                  {
                    "text": "Pneumonie",
                    "cause": "Arguments CONTRE:\n\t□ Fièvre modérée\n\t□ Hyperinflation\n\t□ Pas de foyer auscultatoire",
                    "test": "→ Radio thorax"
                  }
                ]

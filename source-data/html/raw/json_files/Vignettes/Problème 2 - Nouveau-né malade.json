    "management": {
      "weight": 0.25,
      "criteria": [
        {
          "id": "m1",
          "text": "Diagnostics différentiels de la détresse respiratoire néonatale",
          "ddSection": {
            "title": "Causes de détresse respiratoire chez le nouveau-né",
            "categories": [
              {
                "name": "Causes infectieuses",
                "items": [
                  {
                    "text": "Sepsis néonatal à Streptocoque B",
                    "cause": "Arguments POUR:\n\t□ Détresse respiratoire précoce\n\t□ Signes de choc (hypotonie, TRC allongé)\n\t□ Polypnée > 60/min avec grunting\n\t□ Aspect gris-violacé\n\t□ Évolution rapide après période libre",
                    "test": "→ Hémoculture, PL, CRP, PCT, radiographie thoracique"
                  },
                  {
                    "text": "Pneumonie néonatale",
                    "cause": "Arguments POSSIBLES:\n\t□ Détresse respiratoire\n\t□ Murmure vésiculaire diminué\n\t□ Peut être associée au sepsis",
                    "test": "→ Radiographie thoracique, cultures"
                  }
                ]
              },
              {
                "name": "Causes pulmonaires",
                "items": [
                  {
                    "text": "Tachypnée transitoire (wet lung)",
                    "cause": "Arguments MIXTES:\n\t□ POUR: Nouveau-né à terme, polypnée\n\t□ CONTRE: Évolution trop sévère, signes de choc",
                    "test": "→ Radiographie: infiltrats péri-hilaires"
                  },
                  {
                    "text": "Maladie des membranes hyalines",
                    "cause": "Arguments CONTRE:\n\t□ Bébé à terme (rare à terme)\n\t□ Poids normal pour l'âge",
                    "test": "→ Radiographie: aspect réticulogranulaire"
                  },
                  {
                    "text": "Syndrome d'aspiration méconiale",
                    "cause": "Arguments À VÉRIFIER:\n\t□ Liquide amniotique teinté?\n\t□ Méconium dans les voies aériennes?\n\t□ Détresse respiratoire immédiate",
                    "test": "→ Radiographie: infiltrats en patches"
                  }
                ]
              },
              {
                "name": "Causes cardiaques",
                "items": [
                  {
                    "text": "Cardiopathie congénitale cyanogène",
                    "cause": "Arguments POSSIBLES:\n\t□ Cyanose centrale\n\t□ Détresse respiratoire\n\t□ Mais absence de souffle",
                    "test": "→ Échocardiographie, test d'hyperoxie"
                  },
                  {
                    "text": "Hypertension pulmonaire persistante",
                    "cause": "Arguments À CONSIDÉRER:\n\t□ Cyanose réfractaire\n\t□ Après asphyxie périnatale\n\t□ Différence de saturation pré/post-ductale",
                    "test": "→ Échocardiographie, gaz du sang"
                  }
                ]
              },
              {
                "name": "Autres causes",
                "items": [
                  {
                    "text": "Pneumothorax",
                    "cause": "Arguments CONTRE:\n\t□ Murmure vésiculaire bilatéral\n\t□ Pas d'asymétrie thoracique",
                    "test": "→ Radiographie thoracique, transillumination"
                  },
                  {
                    "text": "Hernie diaphragmatique",
                    "cause": "Arguments CONTRE:\n\t□ Pas de scaphoïde abdomen\n\t□ Murmure vésiculaire présent bilatéralement",
                    "test": "→ Radiographie: organes abdominaux dans thorax"
                  }
                ]
              }
            ]
